PROJECT_NAME           = "dmzap call graph"
OUTPUT_DIRECTORY       = docs-dmzap
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

INPUT                  = drivers/md
FILE_PATTERNS          = dm-zap-*.c dm-zap-*.h
RECURSIVE              = NO

HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_MULTI_TARGETS      = YES
DOT_GRAPH_MAX_NODES    = 400
MAX_DOT_GRAPH_DEPTH    = 0
DOT_IMAGE_FORMAT       = svg
DOT_TRANSPARENT        = YES
DOT_CLEANUP            = YES

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
SOURCE_BROWSER         = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
FULL_PATH_NAMES        = NO
EXCLUDE_PATTERNS       = *mod.c
ENABLED_SECTIONS       =

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = __KERNEL__=1 \
                         __inline__=inline \
                         __always_inline__=inline \
                         likely(x)=x \
                         unlikely(x)=x

INCLUDE_PATH           = include \
                         include/uapi \
                         arch/x86/include \
                         arch/x86/include/uapi \
                         drivers/md
STRIP_FROM_PATH        = .

